<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical">

    <LinearLayout android:background="#fdb46d" android:id="@+id/Layouttopo_Luc" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

        <ImageView android:layout_height="wrap_content" android:layout_width="wrap_content" android:src="@drawable/icone_programa"/>

        <LinearLayout android:gravity="center_vertical" android:id="@+id/layout_titulo_programa_luc" android:layout_gravity="center" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical">

            <TextView android:gravity="center" android:layout_gravity="center" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Listagem de" android:textAppearance="?android:attr/textAppearanceLarge"/>

            <TextView android:gravity="center" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Usuários" android:textAppearance="?android:attr/textAppearanceLarge"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:gravity="right" android:id="@+id/layout_status_luc" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

        <TextView android:id="@+id/txtstatus" android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingRight="10dp" android:text="Registros: 1/10" android:textAppearance="?android:attr/textAppearanceMedium"/>
    </LinearLayout>

    <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Nome:" android:textAppearance="?android:attr/textAppearanceMedium"/>

    <TextView android:id="@+id/txtnome" android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingTop="5dp" android:text="[NOME]" android:textAppearance="?android:attr/textAppearanceMedium" android:textColor="#fb7600"/>

    <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingTop="15dp" android:text="Endereço:" android:textAppearance="?android:attr/textAppearanceMedium"/>

    <TextView android:id="@+id/txtendereco" android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingTop="5dp" android:text="[ENDERECO]" android:textAppearance="?android:attr/textAppearanceMedium" android:textColor="#fb7600"/>

    <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingTop="15dp" android:text="Telefone :" android:textAppearance="?android:attr/textAppearanceMedium"/>

    <TextView android:id="@+id/txttelefone" android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingTop="5dp" android:text="[TELEFONE]" android:textAppearance="?android:attr/textAppearanceMedium" android:textColor="#fb7600"/>

    <LinearLayout android:gravity="center" android:id="@+id/Layout_botoes_luc" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:paddingTop="10dp">

        <Button android:id="@+id/btanterior" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Anterior"/>

        <Button android:id="@+id/btproximo" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Próximo"/>
    </LinearLayout>

    <LinearLayout android:gravity="center" android:id="@+id/Layout_botao_fechar" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical">

        <Button android:id="@+id/btfechar" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Fechar"/>
    </LinearLayout>
</LinearLayout>